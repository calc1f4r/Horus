# Generated local backups / graphify internals
DB/index.old.json
DB/graphify-out/.graphify_*.json
DB/graphify-out/.graphify_python
DB/graphify-out/.graphify_uncached.txt
DB/graphify-out/cache/

# ── Untracked large artifacts (present on disk, regenerated or branch-hosted) ──
# Rebuild the DB knowledge graph with: horus db graph
DB/graphify-out/graph.json
# One-shot enrichment-campaign byproducts; the .md summaries stay tracked
DB/_telemetry/huntcard-enrichment/*.json
# Report corpora live on the 48 origin/reports/* branches (see docs/codebase-structure.md).
# Fetch one with: git fetch origin reports/<topic> && git checkout origin/reports/<topic> -- .
reports/

# ── Third-party target code copied in for paper experiments ──
# Per-trial sandbox copies of EVMbench/annex target repositories. 15 of the 40
# EVMbench detect targets are copyleft or source-available (see
# benchmark/registry/target-license-census.csv), so their code must never be
# committed into this Apache-2.0 repository or shipped in the released
# artifact. The paper references targets by upstream commit instead.
experiments/runs/**/sandbox/

